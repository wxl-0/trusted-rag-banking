# 复制本文件为 .env 后再填写。不要提交填写后的 .env。
OPENAI_API_KEY=YOUR_API_KEY_HERE
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=deepseek-v4-flash
CONTEXT_NORMAL_INPUT_TOKENS=65536
CONTEXT_COMPLEX_INPUT_TOKENS=131072
CONTEXT_HARD_INPUT_TOKENS=204800
CONTEXT_OUTPUT_RESERVE_TOKENS=8192
CONTEXT_RECENT_HISTORY_TOKENS=16384
CONTEXT_SUMMARY_TOKENS=8192

# PostgreSQL 是业务事实来源；请为本地环境替换占位密码。
POSTGRES_DB=trusted_rag
POSTGRES_USER=trusted_rag
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://trusted_rag:CHANGE_ME@localhost:5432/trusted_rag

# 仅用于 `docker compose --profile test up -d postgres-test` 提供的可丢弃测试库。
TRUSTED_RAG_TEST_DATABASE_URL=postgresql+psycopg://trusted_rag_test:trusted_rag_test@localhost:5433/trusted_rag_test

# Keycloak/OIDC。管理员密码必须在本地替换；公开演示账号见 README 和 realm-export。
# 演示凭证只用于本地展示，不能复用到任何真实环境。
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_ISSUER=http://localhost:8080/realms/trusted-rag
KEYCLOAK_AUDIENCE=trusted-rag-api
VITE_KEYCLOAK_AUTHORITY=http://localhost:8080/realms/trusted-rag
VITE_KEYCLOAK_CLIENT_ID=trusted-rag-web

# 首次运行会按 Hugging Face 模型名下载到本地缓存。
EMBED_MODEL=BAAI/bge-large-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
HF_HOME=./models
HF_HUB_OFFLINE=0

# Docker Compose 启动时由 compose 文件覆盖为 qdrant；本地运行使用 localhost。
QDRANT_HOST=localhost
QDRANT_PORT=6333
