{
  "realm": "trusted-rag",
  "enabled": true,
  "displayName": "可信监管知识库",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "member", "description": "企业成员" },
      { "name": "knowledge_maintainer", "description": "知识库维护者" }
    ]
  },
  "clients": [
    {
      "clientId": "trusted-rag-api",
      "name": "可信监管知识库 API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "trusted-rag-web",
      "name": "可信监管知识库 Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://localhost/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173",
        "http://localhost"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://127.0.0.1:5173/*##http://localhost/*"
      },
      "protocolMappers": [
        {
          "name": "trusted-rag-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "trusted-rag-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "演示",
      "lastName": "成员",
      "email": "admin01@example.invalid",
      "credentials": [
        { "type": "password", "value": "12301", "temporary": false }
      ],
      "realmRoles": ["member"]
    },
    {
      "username": "admin02",
      "enabled": true,
      "emailVerified": true,
      "firstName": "演示",
      "lastName": "维护者",
      "email": "admin02@example.invalid",
      "credentials": [
        { "type": "password", "value": "12302", "temporary": false }
      ],
      "realmRoles": ["knowledge_maintainer"]
    }
  ]
}
